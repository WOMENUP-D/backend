# Copy to .env and fill in. Never commit a real .env.

# --- General ---
ENVIRONMENT=local
DEBUG=true
APP_NAME="WomanUP Portal API"

# --- Database (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://womanup:CHANGE_ME@localhost:5432/womanup
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Cache / queue ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_64_BYTE_SECRET
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Firebase (Google sign-in) ---
# From one service-account JSON: Firebase console -> Project settings ->
# Service accounts -> Generate new private key. Three fields out of that file.
# The private key is a real secret. Paste it on ONE line with the newlines
# written as 
, exactly as it appears in the JSON, and keep the quotes.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""
# Leave empty for a public portal. Set to a Workspace domain (e.g. womanup.uz)
# to accept only accounts from that domain.
FIREBASE_ALLOWED_DOMAIN=

# --- Localisation ---
DEFAULT_LANGUAGE=uz

# --- AI layer ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=high
AI_MAX_TOKENS=16000
AI_RAG_TOP_K=6
AI_MIN_CONFIDENCE=0.35
EMBEDDING_DIMENSIONS=1024

# --- AI news ingestion (every 8 hours) ---
# ENABLED turns the search on; it is off by default so a fresh checkout and CI
# never make a paid outbound call on a timer. AUTO_PUBLISH decides whether what
# the search finds may reach a reader without a human, and it defaults to true:
# the honest tradeoff is that the feed stays alive without a moderator on shift
# three times a day, at the cost that a badly framed article from a trusted
# source can reach a reader before anyone has read it — the code gate in
# services/news_ingest.py narrows that risk (attribution, a trusted source
# host, the safety keyword filter, no verdict vocabulary, no ANNOUNCEMENT) but
# does not eliminate it. Set AUTO_PUBLISH=false to run the same job as a
# drafting aid: everything lands as a draft and the feed changes only when an
# editor publishes it.
NEWS_INGEST_ENABLED=false
NEWS_INGEST_AUTO_PUBLISH=true
NEWS_INGEST_INTERVAL_HOURS=8
NEWS_INGEST_MAX_POSTS=6
NEWS_INGEST_LOOKBACK_HOURS=48
NEWS_INGEST_DEDUP_DAYS=30
# Comma-separated allowlist. The search and fetch tools are restricted to
# these, and the code re-checks the fetched URL against the same list. Widening
# it lets the job SEARCH a site; it does not by itself let that site
# auto-publish — that list is TRUSTED_DOMAINS in services/news_ingest.py.
NEWS_INGEST_ALLOWED_DOMAINS=uza.uz,gov.uz,ssv.uz,minzdrav.uz,stat.uz,lex.uz,who.int,un.org,unwomen.org,unicef.org,unesco.org,unfpa.org,nobelprize.org,thelancet.com,nature.com,science.org,bmj.com,nejm.org,cochrane.org,cdc.gov

# --- Outbound channels ---
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
# Sign-in codes are sent from here. Without a host the API refuses to pretend
# it posted one: outside local development /auth/otp/request returns 503.
# Port 465 uses implicit TLS; anything else starts plain and upgrades.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# What she sees in the From line. Defaults to SMTP_USER.
SMTP_FROM="WomanUP <no-reply@womanup.uz>"

# --- Partner platforms ---
EDU_JOB_BASE_URL=
EDU_JOB_CLIENT_ID=
EDU_JOB_CLIENT_SECRET=

INVEST_HUB_BASE_URL=
INVEST_HUB_CLIENT_ID=
INVEST_HUB_CLIENT_SECRET=

COMMERCE_BASE_URL=
COMMERCE_CLIENT_ID=
COMMERCE_CLIENT_SECRET=

# --- hh.uz vacancy feed (read-only) ---
# The worker pulls open vacancies for Uzbekistan into the catalogue under the
# source `hh_uz`. Vacancy search needs an application registered at
# https://dev.hh.ru: either paste an application token, or give the client id
# and secret and the worker exchanges them itself. Nothing is ever sent back.
HH_SYNC_ENABLED=false
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_ACCESS_TOKEN=
# "App/version (contact e-mail)" — the API refuses requests without one.
HH_USER_AGENT="WomanUP/1.0 (support@womanup.uz)"
HH_SYNC_INTERVAL_HOURS=6
# Comma-separated search queries; the default list covers the roles women on
# the portal ask about most. Each query reads up to 50 open vacancies.
# HH_SEARCH_QUERIES=бухгалтер,менеджер по продажам,учитель
HH_SYNC_MAX_NEW=300
HH_SYNC_STALE_DAYS=10

# --- Vacancy marketplace (/api/v1/vacancies) ---
# Which job board the marketplace reads live. `headhunter` uses the HH_*
# credentials above; a Tijorat Markazi provider will register its own name.
VACANCY_PROVIDER=headhunter
# How long a page of results and one listing are served from cache (seconds).
VACANCY_SEARCH_CACHE_SECONDS=300
VACANCY_DETAIL_CACHE_SECONDS=900

# --- Sessions ---
# The refresh token is an HttpOnly cookie on the auth endpoints. Secure is on
# everywhere but local development; set AUTH_COOKIE_SECURE explicitly to force.
AUTH_COOKIE_NAME=wu_refresh
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=
# Host names the API answers for; "*" trusts the proxy. Set in production.
ALLOWED_HOSTS=*
# Wrong passwords one account may receive per hour before it is held.
LOGIN_FAILURES_PER_HOUR=20
STAFF_LOGIN_FAILURES_PER_HOUR=10

# --- Abuse limits ---
# Model-backed answers per hour, per signed-in account and per anonymous IP.
AI_USER_HOURLY_LIMIT=60
AI_GUEST_IP_HOURLY_LIMIT=20
# Requests per minute one address may make to the API, and to the expensive
# paths (job-board proxy, model-backed endpoints). Per worker.
RATE_LIMIT_PER_MINUTE=600
EXPENSIVE_RATE_LIMIT_PER_MINUTE=60
# Largest accepted request body, in bytes.
MAX_REQUEST_BODY_BYTES=2000000

# --- Retention ---
# Assistant prompt/answer excerpts are blanked after this many days; spent
# one-time codes are dropped after this many hours. Swept hourly by the worker.
AI_TRACE_RETENTION_DAYS=180
OTP_RETENTION_HOURS=24

# --- Object storage (S3-compatible) ---
S3_ENDPOINT_URL=
S3_BUCKET=womanup-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Security ---
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=120
